# Copia este archivo como ".env" y coloca tus datos reales.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# Conexión a PostgreSQL:  postgres://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgres://postgres:TU_CONTRASEÑA_DE_POSTGRES@localhost:5432/club_makarios

# Puerto donde se abre la aplicación (http://localhost:3000)
PORT=3000

# Horas que dura una sesión antes de pedir login otra vez
SESSION_HOURS=8

# Solo si publicas la página en otro dominio (por ejemplo GitHub Pages):
# CORS_ORIGIN=https://tu-usuario.github.io
